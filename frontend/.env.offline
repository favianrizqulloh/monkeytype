# Offline Mode Environment Configuration
# This file is used when building the offline portable app with: npm run build-offline

# Enable offline mode
VITE_OFFLINE_MODE=true
OFFLINE=true

# Disable all external services
SENTRY=false
RECAPTCHA_SITE_KEY=offline-mode-no-recaptcha
BACKEND_URL=

# Disable dev tools for production
SERVER_OPEN=false

# Build configuration
VITE_APP_TITLE=Monkeytype - Offline Edition
NODE_ENV=production
