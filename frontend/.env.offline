# Offline Mode Environment Configuration
# Used when building: npm run build-offline
# This configuration ensures ZERO network requests

# Enable offline mode - this flag gates all network operations
VITE_OFFLINE_MODE=true
OFFLINE=true

# Disable all external services
SENTRY=false
RECAPTCHA_SITE_KEY=offline-no-recaptcha-needed
BACKEND_URL=

# Disable telemetry and reporting
VITE_ENABLE_SENTRY=false
VITE_ENABLE_ANALYTICS=false

# Build configuration
VITE_APP_TITLE=Monkeytype - Offline Edition
NODE_ENV=production

# Dev tools disabled in offline production build
SERVER_OPEN=false
